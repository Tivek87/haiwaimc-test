# Palmkruin, uitgevoerd op het blok direct boven de bovenste stam
fill ~-2 ~ ~ ~2 ~ ~ minecraft:jungle_leaves[persistent=true]
fill ~ ~ ~-2 ~ ~ ~2 minecraft:jungle_leaves[persistent=true]
setblock ~1 ~ ~1 minecraft:jungle_leaves[persistent=true]
setblock ~-1 ~ ~1 minecraft:jungle_leaves[persistent=true]
setblock ~1 ~ ~-1 minecraft:jungle_leaves[persistent=true]
setblock ~-1 ~ ~-1 minecraft:jungle_leaves[persistent=true]
setblock ~ ~1 ~ minecraft:jungle_leaves[persistent=true]
# hangende bladpunten
setblock ~3 ~-1 ~ minecraft:jungle_leaves[persistent=true]
setblock ~-3 ~-1 ~ minecraft:jungle_leaves[persistent=true]
setblock ~ ~-1 ~3 minecraft:jungle_leaves[persistent=true]
setblock ~ ~-1 ~-3 minecraft:jungle_leaves[persistent=true]
setblock ~2 ~-1 ~2 minecraft:jungle_leaves[persistent=true]
setblock ~-2 ~-1 ~2 minecraft:jungle_leaves[persistent=true]
setblock ~2 ~-1 ~-2 minecraft:jungle_leaves[persistent=true]
setblock ~-2 ~-1 ~-2 minecraft:jungle_leaves[persistent=true]
# kokosnoten (cacao) aan de stam
setblock ~1 ~-1 ~ minecraft:cocoa[facing=west,age=2]
setblock ~-1 ~-1 ~ minecraft:cocoa[facing=east,age=2]
setblock ~ ~-1 ~1 minecraft:cocoa[facing=north,age=2]
